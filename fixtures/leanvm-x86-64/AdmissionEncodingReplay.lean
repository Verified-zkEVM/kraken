import StockStubText
import Kraken.X64.PrintATT

namespace LeanVM.Admission

private def rowStart (index : Nat) : String := s!".Lrow_{index}"
private def rowEnd (index : Nat) : String := s!".Lafter_{index}"
private def sectionOffset (pc : Int64) : Nat := pc.toBitVec.toNat - 0x400000

private def renderRow (pc : Int64) (instruction : Kraken.Sized Directive) (index : Nat) :
    IO (String × List String) := do
  let printed := Kraken.X64.ATT.directive instruction.directive
  if (pc == 0x4003d1 || pc == 0x4003e5) && printed.startsWith "cmpq $" then
    match (printed.drop 6).toString.splitOn ", " with
    | [immediate, destination] =>
      let symbol := s!".Lcmp_{index}"
      return (s!"cmpq ${symbol}, {destination}", [s!".set {symbol}, {immediate}"])
    | _ => throw (IO.userError s!"Unexpected printed CMP instruction: {printed}")
  if printed.startsWith "call " then
    return (s!"call {rowEnd index}+({(printed.drop 5).toString})", [])
  return (printed, [])

private def branchSymbols : IO (List (Nat × String)) := do
  let some (_, rangeTarget) :=
    decodeStockRel32 stockAdmissionRows[1].1 stockAdmissionRows[1].2
    | throw (IO.userError "Could not decode the stock range branch")
  let some (_, budgetTarget) :=
    decodeStockRel32 stockAdmissionRows[4].1 stockAdmissionRows[4].2
    | throw (IO.userError "Could not decode the stock budget branch")
  return [(sectionOffset budgetTarget, "reject_input"), (sectionOffset rangeTarget, "reject_range")]

private def renderAssembly (rows : List (Int64 × Kraken.Sized Directive))
    (targets : List (Nat × String)) : IO String := do
  let first :: _ := rows | throw (IO.userError "Missing instruction rows")
  let mut lines := [".text", s!".org {sectionOffset first.1}"]
  let mut equates := []
  for ((pc, instruction), index) in rows.zipIdx do
    let (asm, trailing) ← renderRow pc instruction index
    lines := lines ++ [s!"{rowStart index}:", asm, s!"{rowEnd index}:"]
    equates := equates ++ trailing
  let labels := targets.flatMap fun (offset, name) => [s!".org {offset}", s!"{name}:"]
  return "\n".intercalate (lines ++ equates ++ labels) ++ "\n"

private def runTool (directory : System.FilePath) (cmd : String) (args : Array String) :
    IO String := do
  let result ← IO.Process.output { cmd, args, cwd := some directory, env := #[("LC_ALL", some "C")] }
  unless result.exitCode == 0 do
    throw (IO.userError s!"{cmd} exited {result.exitCode}\n{result.stderr}")
  return result.stdout

private def symbolOffset (symbols : String) (name : String) : IO Nat := do
  for line in symbols.splitOn "\n" do
    match (line.splitOn " ").filter (· != "") with
    | symbol :: _ :: value :: _ =>
      if symbol == name then
        let some offset := value.toNat? | throw (IO.userError s!"Invalid offset for {name}")
        return offset
    | _ => pure ()
  throw (IO.userError s!"Missing assembly symbol {name}")

private def assembleRows (directory : System.FilePath) (rows : List (Int64 × Kraken.Sized Directive))
    (targets : List (Nat × String)) (start stop : Nat) :
    IO (List UInt8) := do
  IO.FS.writeFile (directory / "admission.s") (← renderAssembly rows targets)
  let _ ← runTool directory "as" #["--64", "--keep-locals", "--fatal-warnings", "-o",
    "admission.o", "admission.s"]
  let relocations ← runTool directory "readelf" #["-rW", "admission.o"]
  unless relocations.trimAscii.toString == "There are no relocations in this file." do
    throw (IO.userError s!"Unexpected assembly relocations\n{relocations}")
  let symbols ← runTool directory "nm" #["--format=posix", "--radix=d", "admission.o"]
  for (expectedOffset, name) in targets do
    unless (← symbolOffset symbols name) == expectedOffset do
      throw (IO.userError s!"Assembly label {name} has a different address")
  for ((pc, instruction), index) in rows.zipIdx do
    let start ← symbolOffset symbols (rowStart index)
    let stop ← symbolOffset symbols (rowEnd index)
    unless start == sectionOffset pc && stop == start + instruction.size do
      throw (IO.userError s!"Assembly instruction {index} has a different start or size")
  let _ ← runTool directory "objcopy" #["-O", "binary", "-j", ".text", "admission.o", "admission.bin"]
  let bytes ← IO.FS.readBinFile (directory / "admission.bin")
  unless start ≤ stop && stop ≤ bytes.size do
    throw (IO.userError "Assembly instruction interval lies outside the generated bytes")
  if targets.isEmpty && bytes.size != stop then
    throw (IO.userError "Assembly contains bytes after the expected instruction interval")
  return (bytes.extract start stop).toList

private def directiveRows (rows : List StockAdmissionRow) : List (Int64 × Kraken.Sized Directive) :=
  rows.map fun row => (row.pc, row.instruction)

private def withChangedRangeImmediate (rows : List StockAdmissionRow) : IO (List StockAdmissionRow) := do
  let first :: rest := rows | throw (IO.userError "Missing stock admission rows")
  let .instr (.regular aw w (.cmp destination (.imm (.int64 immediate)))) :=
    first.instruction.directive | throw (IO.userError "Expected the stock range CMP first")
  let directive := .instr (.regular aw w (.cmp destination (.imm (.int64 (immediate + 1)))))
  return { first with instruction := { first.instruction with directive } } :: rest

private def replayAdmissionEncoding : IO Unit := IO.FS.withTempDir fun directory => do
  let targets ← branchSymbols
  let assemble rows := assembleRows directory (directiveRows rows) targets 0x3d1 0x449
  let assembled ← assemble stockAdmissionPlan
  unless assembled == stockAdmissionBytes do
    throw (IO.userError "Assembled admission instructions differ from the stock bytes")
  let changed ← assemble (← withChangedRangeImmediate stockAdmissionPlan)
  unless changed != assembled && changed.drop rangeCmp.size == assembled.drop rangeCmp.size do
    throw (IO.userError "The changed range CMP operand must change only the first row")

  let moveIndex := 8
  let some move := stockAdmissionPlan[moveIndex]? | throw (IO.userError "Missing stock stack MOV")
  let .instr (.regular aw .W64 (.mov (.reg (.low .rsp .W64)) source)) := move.instruction.directive
    | throw (IO.userError "Expected the stock MOV into RSP")
  let directive := .instr (.regular aw .W64 (.mov (.reg (.low .rbp .W64)) source))
  let changedMove := { move with instruction := { move.instruction with directive } }
  let moved ← assemble (stockAdmissionPlan.set moveIndex changedMove)
  let start := sectionOffset move.pc - 0x3d1
  let stop := start + move.instruction.size
  unless moved != stockAdmissionBytes && moved.take start == assembled.take start &&
      moved.drop stop == assembled.drop stop do
    throw (IO.userError "The changed stack MOV destination must change only its instruction row")

  IO.println "All 16 printed instructions match the stock bytes and boundaries."
  IO.println "The changed range CMP operand differs from the stock bytes."
  IO.println "The changed stack MOV destination differs from the stock bytes."

#eval replayAdmissionEncoding

private def stockCaseSelectionRows : List StockAdmissionRow :=
  [ ⟨0x4003be, [0x4c, 0x8d, 0x25, 0x3b, 0x2c, 0x00, 0x00], selectCaseLea⟩
  , ⟨0x4003c5, [0x48, 0xc1, 0xe3, 0x05], selectCaseShift⟩
  , ⟨0x4003c9, [0x49, 0x01, 0xdc], selectCaseAdd⟩
  , ⟨0x4003cc, [0x49, 0x8b, 0x54, 0x24, 0x08], selectCaseLength⟩ ]

private def replayCaseSelectionEncoding : IO Unit := IO.FS.withTempDir fun directory => do
  let assemble rows := assembleRows directory (directiveRows rows) [] 0x3be 0x3d1
  let assembled ← assemble stockCaseSelectionRows
  unless assembled == stockCaseSelectionRows.flatMap (·.bytes) do
    throw (IO.userError "Assembled case selector differs from the stock bytes")
  let some shift := stockCaseSelectionRows[1]? | throw (IO.userError "Missing stock selector shift")
  let changedShift := { shift with instruction := ⟨⸨dir| shlq $4, %rbx⸩, shift.instruction.size⟩ }
  let changed ← assemble (stockCaseSelectionRows.set 1 changedShift)
  let start := sectionOffset shift.pc - 0x3be
  let stop := start + shift.instruction.size
  unless changed != assembled && changed.take start == assembled.take start &&
      changed.drop stop == assembled.drop stop do
    throw (IO.userError "The changed case shift must change only its instruction row")
  IO.println "All four printed case-selection instructions match the stock bytes and boundaries."
  IO.println "The changed case-selection shift differs from the stock bytes."

#eval replayCaseSelectionEncoding

private def replayStockStubEncoding : IO Unit := IO.FS.withTempDir fun directory => do
  let rows := stockStubText.withAddresses.map fun row => (row.addr, row.toSized)
  let assemble rows := assembleRows directory rows [] 0x2f0 0x51b
  let assembled ← assemble rows
  IO.FS.writeBinFile (directory / "stub.text") ⟨assembled.toArray⟩
  let digest ← runTool directory "sha256sum" #["stub.text"]
  let expected := "a383fe100af5c52ec26dbe1efefa26aaef55111e026c76caad752aba6e43324e"
  unless digest == s!"{expected}  stub.text\n" do
    throw (IO.userError s!"Reassembled stock stub digest differs: {digest}")

  let pc := (0x400303 : Int64)
  let some index := rows.findIdx? (fun row => row.1 == pc)
    | throw (IO.userError "Missing stock selector normalization instruction")
  let changedRow := (pc, ⟨⸨dir| sub $0x31,%ebx⸩, 3⟩)
  let changed ← assemble (rows.set index changedRow)
  let start := sectionOffset pc - 0x2f0
  unless changed != assembled && changed.take start == assembled.take start &&
      changed.drop (start + 3) == assembled.drop (start + 3) do
    throw (IO.userError "The changed selector normalization must change only its instruction row")
  IO.println "The full 555-byte stock stub matches the pinned digest and directive boundaries."
  IO.println "The changed selector normalization differs from the stock bytes."

#eval replayStockStubEncoding

end LeanVM.Admission
